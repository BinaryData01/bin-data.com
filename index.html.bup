<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Binary Data | Sitio Oficial</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        body {
            background: #000000;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #ffffff;
            position: relative;
        }

        /* Animated Grid Background */
        .background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                linear-gradient(0deg, transparent 24%, rgba(0, 217, 255, 0.08) 25%, rgba(0, 217, 255, 0.08) 26%, transparent 27%, transparent 74%, rgba(0, 217, 255, 0.08) 75%, rgba(0, 217, 255, 0.08) 76%, transparent 77%, transparent),
                linear-gradient(90deg, transparent 24%, rgba(0, 217, 255, 0.08) 25%, rgba(0, 217, 255, 0.08) 26%, transparent 27%, transparent 74%, rgba(0, 217, 255, 0.08) 75%, rgba(0, 217, 255, 0.08) 76%, transparent 77%, transparent);
            background-size: 80px 80px;
            z-index: -1;
            pointer-events: none;
        }

        .container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 1200px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem;
            gap: 2rem;
        }

        /* Top Section - Logo */
        .top-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            animation: slideDown 0.6s ease-out;
        }
        
        .logo-wrapper {
            max-width: 90%;
            width: 100%;
            display: flex;
            justify-content: center;
            padding: 0 1rem;
        }
        
        .logo-wrapper img {
            max-width: 90%;
            height: auto;
            max-height: 80px;
            width: auto;
            filter: drop-shadow(0 0 20px rgba(0, 217, 255, 0.4));
            transition: all 0.3s ease;
        }

        .logo-wrapper img:hover {
            filter: drop-shadow(0 0 40px rgba(0, 217, 255, 0.8)) brightness(1.1);
        }

        /* Divider */
        .divider-line {
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, transparent, #00d9ff, #0099ff, transparent);
        }

        /* Main Content Section */
        .main-section {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            align-items: center;
            width: 100%;
            animation: fadeIn 0.8s ease-out 0.2s both;
        }

        /* Right - Text Content */
        .text-section {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            text-align: center;
            align-items: center;
        }

        .text-section h2 {
            font-size: 2.2rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.3;
            letter-spacing: -0.5px;
            max-width: 600px;
        }

        .text-section h2 span {
            background: linear-gradient(90deg, #00d9ff, #0099ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .text-section p {
            font-size: 1.05rem;
            color: #b0b0b0;
            line-height: 1.8;
            max-width: 550px;
        }

        /* Status Box */
        .status-container {
            background: rgba(0, 217, 255, 0.08);
            border: 1px solid rgba(0, 217, 255, 0.25);
            border-radius: 6px;
            padding: 1.5rem;
            margin-top: 1rem;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .status-container:hover {
            background: rgba(0, 217, 255, 0.12);
            border-color: rgba(0, 217, 255, 0.4);
            box-shadow: 0 0 30px rgba(0, 217, 255, 0.15);
        }

        .status-label {
            font-size: 0.75rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 0.8rem;
            font-weight: 600;
        }

        .status-text {
            font-size: 0.95rem;
            color: #ddd;
            line-height: 1.6;
        }

        .status-link {
            color: #00d9ff;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.3s ease;
            border-bottom: 2px solid rgba(0, 217, 255, 0.3);
            display: inline;
        }

        .status-link:hover {
            color: #00ffff;
            border-bottom-color: #00ffff;
            text-shadow: 0 0 15px rgba(0, 217, 255, 0.6);
        }

        /* Animations */
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .main-section {
                gap: 2rem;
            }

            .text-section h2 {
                font-size: 1.5rem;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 1.5rem;
                gap: 1.5rem;
            }

            .logo-wrapper img {
                max-height: 60px;
            }

            .main-section {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .image-section {
                order: 2;
            }

            .text-section {
                order: 1;
                align-items: center;
                text-align: center;
            }

            .text-section p {
                max-width: 100%;
            }

            .robot-container {
                max-width: 300px;
            }

            .text-section h2 {
                font-size: 1.3rem;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 1rem;
                gap: 1rem;
            }

            .logo-wrapper img {
                max-height: 50px;
            }

            .top-section {
                gap: 0.8rem;
            }

            .main-section {
                gap: 1.5rem;
            }

            .text-section h2 {
                font-size: 1.1rem;
            }

            .text-section p {
                font-size: 0.9rem;
            }

            .robot-container {
                max-width: 250px;
            }

            .status-container {
                padding: 1rem;
            }

            .status-text {
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>
    <div class="background"></div>

    <div class="container">
        <!-- Top: Logo -->
        <div class="top-section">
            <div class="logo-wrapper">
                <img src="Binary_Data_-_WEB.png" alt="Binary Data Logo" title="Binary_Data01">
            </div>
            <div class="divider-line"></div>
        </div>

        <!-- Main: Text Content Centered -->
        <div class="main-section">
            <!-- Text Content -->
            <div class="text-section">
                <div class="status-container">
                    <div class="status-text">
                        Sitio en construcción<br>
                        Seguinos en <a href="https://X.com/binary_data01" target="_blank" class="status-link">@Binary_Data01</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
